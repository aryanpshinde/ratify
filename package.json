{
  "name": "ratify",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @ratify/shared build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @ratify/shared build && pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.tmp",
    "format": "prettier --write ."
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}

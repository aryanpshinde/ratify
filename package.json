{
  "name": "ratify",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.0.0",
  "scripts": {
    "dev": "pnpm --filter @ratify/shared build && pnpm --parallel -r run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter @ratify/shared build && pnpm -r run typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules/.tmp",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project shared --project api",
    "test:watch": "vitest --project shared --project api",
    "test:integration": "vitest run --project api-integration"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.6",
    "vitest": "^5.0.3"
  }
}
